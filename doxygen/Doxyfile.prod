# FEZ Jour 1 — snapshot partiel, branche prod
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "FEZ — CHNS ALE · branche personnelle"
PROJECT_NUMBER         = "35d43b8e3bc4 · Jour 1"
PROJECT_BRIEF          = "Référence partielle des sources sélectionnées — lecture GitHub, sans build FEZ"
OUTPUT_DIRECTORY       = "prod"
OUTPUT_LANGUAGE        = French
INPUT                  = "guides/prod" "snapshots/prod/include" "snapshots/prod/src" "snapshots/prod/solvers"
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cpp *.cc *.md
RECURSIVE              = YES
EXCLUDE_SYMBOLS        = main
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "."
USE_MDFILE_AS_MAINPAGE  = "guides/prod/index.md"
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = DARK
GENERATE_TREEVIEW       = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
HAVE_DOT               = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION         = NO
PREDEFINED             = FEZ_WITH_PETSC
CLANG_ASSISTED_PARSING  = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = "logs/prod-warnings.log"

# Emit protected formula spans; render-math.mjs turns them into local KaTeX HTML.
USE_MATHJAX           = YES
