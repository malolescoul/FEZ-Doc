      <memberdef kind="function" id="class_b_d_f_error_estimator_1a3c8eabffb9392ab2aa7e3c7a0a6a5512" prot="public" static="no" const="yes" explicit="no" inline="no" virt="non-virtual">
        <type>const <ref refid="namespace_l_a_1a71486a471be13e3af27194053d6c8a4b" kindref="member">LA::ParVectorType</ref> &amp;</type>
        <definition>const LA::ParVectorType &amp; BDFErrorEstimator::get_error_estimator_as_solution</definition>
        <argsstring>() const</argsstring>
        <name>get_error_estimator_as_solution</name>
